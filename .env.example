# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.

# GitHub Personal Access Token (https://github.com/settings/tokens)
# Scopes needed: repo (for push to private repos)
GITHUB_TOKEN=

# Kaggle API credentials (https://www.kaggle.com/settings/account → Create New Token)
# Used by scripts/nafp/*.py to download FMA-medium dataset.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face token (https://huggingface.co/settings/tokens)
# Used by scripts/hf/push_hf_dataset.py for publishing.
HF_TOKEN=
